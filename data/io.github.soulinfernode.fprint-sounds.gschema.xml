<?xml version="1.0" encoding="UTF-8"?>
<!--
  The fingerprint sounds' own volume, shared by everything that plays them in a
  user's session: the lock screen (screensaver-fprint), terminal prompts and
  authentication dialogs (greeter-fprint-session-sounds), and set from the
  sound applet and System Settings (cinnamon-extension-fprint). Installed
  system-wide, so every user has it; the value itself is per user.

  The login screen cannot read a user's settings - it runs as lightdm, before
  anyone is logged in - so greeter-fprint-session-sounds keeps a copy of the
  percent in LightDM's per-user greeter data directory
  ($XDG_GREETER_DATA_DIR/fprint-sounds-volume), and the greeter reads it for
  whoever is logging in.
-->
<schemalist gettext-domain="greeter-fprint">
  <schema id="io.github.soulinfernode.fprint-sounds" path="/io/github/soulinfernode/fprint-sounds/">
    <key name="volume" type="i">
      <range min="0" max="100"/>
      <default>100</default>
      <summary>Volume of the fingerprint sounds</summary>
      <description>Percent of the sounds' own level, on the same cubic scale as the desktop's other volume sliders. 0 silences them.</description>
    </key>
  </schema>
</schemalist>
